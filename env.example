# Copy this file to ".env" (same folder) and fill in your real Firebase
# values from: Firebase Console > Project Settings > General > Your apps.
#
# This .env.example file itself IS safe to commit — it has no real values.
# Your actual ".env" file should NOT be committed (see .gitignore).

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
